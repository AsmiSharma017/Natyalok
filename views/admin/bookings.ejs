<%- include("../partials/header") %>

<style>
/* Admin Bookings Table Styling */
.admin-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.admin-title {
  text-align: center;
  color: white;
  font-size: 2.5rem;
  margin-bottom: 2rem;
  text-shadow: 0 2px 10px rgba(0,0,0,0.3);
}

.bookings-table {
  width: 100%;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10px);
}

.bookings-table th {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  padding: 1.2rem 1rem;
  text-align: left;
  font-weight: 600;
  font-size: 1.1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.bookings-table td {
  padding: 1.2rem 1rem;
  border-bottom: 1px solid #e1e8ed;
  vertical-align: middle;
}

.bookings-table tr:hover {
  background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
  transform: scale(1.01);
  transition: all 0.3s ease;
  color: white;
}

.bookings-table tr:last-child td {
  border-bottom: none;
}

/* Status Select Styling */
.status-select {
  width: 140px;
  padding: 0.7rem 1rem;
  border: 2px solid #ddd;
  border-radius: 25px;
  background: white;
  font-size: 0.95rem;
  font-weight: 500;
  transition: all 0.3s ease;
  cursor: pointer;
}

.status-select:focus {
  outline: none;
  border-color: #4facfe;
  box-shadow: 0 0 0 3px rgba(79, 172, 254, 0.2);
}

.status-select option {
  padding: 0.5rem;
}

/* Button Styling */
.update-btn, .delete-btn {
  padding: 0.7rem 1.5rem;
  border: none;
  border-radius: 25px;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.update-btn {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: white;
  margin-right: 0.5rem;
}

.update-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(17, 153, 142, 0.4);
}

.delete-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  color: white;
}

.delete-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(255, 107, 107, 0.4);
}

/* Back Link */
.back-link {
  display: inline-block;
  margin-top: 2rem;
  padding: 1rem 2rem;
  background: rgba(255,255,255,0.2);
  color: white;
  text-decoration: none;
  border-radius: 50px;
  font-weight: 600;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.back-link:hover {
  background: rgba(255,255,255,0.3);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

/* Responsive Design */
@media (max-width: 768px) {
  .admin-container {
    padding: 1rem;
  }
  
  .admin-title {
    font-size: 2rem;
  }
  
  .bookings-table {
    font-size: 0.9rem;
  }
  
  .bookings-table th,
  .bookings-table td {
    padding: 0.8rem 0.5rem;
  }
  
  .status-select {
    width: 120px;
    font-size: 0.9rem;
  }
}
</style>

<div class="admin-container">
  <h1 class="admin-title">Admin – Bookings</h1>

  <table class="bookings-table">
    <tr>
      <th>User</th>
      <th>Movie</th>
      <th>Seats</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>

    <% bookings.forEach(booking => { %>
      <tr>
        <td><%= booking.user?.name || "N/A" %></td>
        <td><%= booking.movie?.title || "N/A" %></td>
        <td><%= booking.seats.join(", ") %></td>
        <td>
          <form action="/admin/bookings/<%= booking._id %>/update" method="POST" style="display: inline;">
            <select name="status" class="status-select">
              <option value="confirmed" <%= booking.status === "confirmed" ? "selected" : "" %>>Confirmed</option>
              <option value="cancelled" <%= booking.status === "cancelled" ? "selected" : "" %>>Cancelled</option>
            </select>
            <button type="submit" class="update-btn">Update</button>
          </form>
        </td>
        <td>
          <form action="/admin/bookings/<%= booking._id %>/delete" method="POST" style="display:inline;">
            <button type="submit" class="delete-btn" onclick="return confirm('Delete booking?')">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>

  <a href="/admin/dashboard" class="back-link">⬅ Back to Dashboard</a>
</div>

<%- include("../partials/footer") %>
